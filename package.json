{
  "name": "@riz007/mcp-apps-ui",
  "version": "0.1.1",
  "description": "Unofficial React components and Tailwind tokens for MCP Apps rendered in Claude. Not affiliated with Anthropic.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/types/components/*/index.d.ts",
      "default": "./dist/components/*/index.js"
    },
    "./css": "./dist/styles/index.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "rm -rf dist && vite build && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "build-storybook": "storybook build --disable-telemetry",
    "test": "vitest run --project unit",
    "test:stories": "vitest run --project stories-light --project stories-dark",
    "types": "tsc --noEmit",
    "lint": "npm run lint:ts && npm run lint:css",
    "lint:ts": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "check:bundle": "node scripts/check-bundle.mjs",
    "prepack": "npm run build && npm run check:bundle",
    "prepublishOnly": "npm run lint && npm run types && npm test"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "tailwindcss": "^4.1.0"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^4.1.11",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riz007/mcp-apps-ui.git"
  },
  "homepage": "https://riz007.github.io/mcp-apps-ui/",
  "keywords": [
    "mcp",
    "mcp-apps",
    "react",
    "tailwind",
    "design-system"
  ]
}
